# ──────────────────────────────────────────────────────────────────────────────
# Environment secrets & API keys
# ──────────────────────────────────────────────────────────────────────────────
# Real secrets — NEVER commit these
.env
.env.local
.env.*.local
env.json
env.test.json
*.key
*.pem

# Generated secrets file — auto-created from env.json by tool/generate_secrets.dart
# Contains real API keys baked in — NEVER commit this
lib/core/config/app_secrets.dart

# Safe templates — commit these so new devs know what keys are needed
# env.example.json       ← commit this
# env.example.test.json  ← commit this

